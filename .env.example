# Desenvolvimento: npm run db:setup gera DATABASE_URL com senha aleatória e grava .env.
# Os nomes legados de banco/container/volume foram preservados para manter seus dados.
# Conta restrita para executar a API (gerada pelo setup; não copie o placeholder).
# DATABASE_URL=postgres://nexus_app_<id>:<senha>@127.0.0.1:5434/bobina
# Conta administrativa exclusiva para migrações locais; não é usada pela API.
MIGRATION_DATABASE_URL=postgres://bobina:bobina@127.0.0.1:5434/bobina
# Opcional: admin de um servidor PostgreSQL exclusivo para testes (precisa CREATE DATABASE/ROLE).
# TEST_ADMIN_DATABASE_URL=postgres://admin:senha@127.0.0.1:5434/postgres
PORT=3333
HOST=127.0.0.1
LOG_LEVEL=info
