{
  "info": {
    "name": "nexus-tasks — cenários do mock",
    "description": "Exclusiva do mock: estado, isolamento de sessão, reset e falhas 503/429. Nenhuma dessas rotas de controle existe na API real.",
    "_postman_id": "9f6ea832-5b3e-83c6-eedf-f9de7cbe95ff",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3334/api",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code !== 204) { pm.test('Resposta JSON',()=>pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json')); }",
          "if (pm.response.code >= 400) pm.test('Erro possui mensagem',()=>pm.expect(pm.response.json().error).to.be.a('string').and.not.empty);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Resetar sessão do mock",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/__mock/reset",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId', Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8));",
              "['todoId','doneId','labelId','branchId','taskId','secondId','lockedTaskId','lockedBranchId','goneTaskId','goneBranchId','completionTaskId'].forEach(k => pm.collectionVariables.unset(k));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP esperado: 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "pm.test(\"Reset confirmado\", () => pm.expect(pm.response.json().ok).to.eql(true));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Simular indisponibilidade",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-mock-scenario",
            "value": "unavailable"
          }
        ],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP esperado: 503', () => pm.expect(pm.response.code).to.be.oneOf([503]));",
              "pm.test(\"Erro genérico\", () => pm.expect(pm.response.json().error).to.eql('Serviço temporariamente indisponível.'));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Simular limite de requisições",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-mock-scenario",
            "value": "rate-limited"
          }
        ],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP esperado: 429', () => pm.expect(pm.response.code).to.be.oneOf([429]));",
              "pm.test('Retry-After fornecido',()=>pm.expect(pm.response.headers.get('Retry-After')).to.eql('5'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Criar dado na sessão padrão",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/columns",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sessão {{runId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP esperado: 201', () => pm.expect(pm.response.code).to.be.oneOf([201]));",
              "if (pm.response.code === 201) pm.collectionVariables.set('todoId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Outro cliente tem estado isolado",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-mock-session",
            "value": "outra-{{runId}}"
          }
        ],
        "url": "{{baseUrl}}/board"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP esperado: 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "pm.test(\"Dado da outra sessão ausente\", () => pm.expect(pm.response.json().columns.some(c=>c.name==='Sessão '+pm.collectionVariables.get('runId'))).to.eql(false));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Sessão original preserva estado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/board"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP esperado: 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "pm.test(\"Dado presente na sessão original\", () => pm.expect(pm.response.json().columns.some(c=>c.id===Number(pm.collectionVariables.get('todoId')))).to.eql(true));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Limpar sessão do mock",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/__mock/reset",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP esperado: 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              ""
            ]
          }
        }
      ]
    }
  ]
}
