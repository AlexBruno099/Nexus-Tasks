{
  "name": "nexus-tasks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Quadro de tarefas estilo kanban com etiquetas, para o trabalho com SmartPOS",
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test": "node --import tsx --test server/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "postman:generate": "node --import tsx scripts/generate-postman.mjs",
    "postman:lint": "postman collection lint postman/collections/bobina-api --fail-severity warning && postman collection lint postman/collections/bobina-regressoes --fail-severity warning && postman collection lint postman/collections/bobina-mock-cenarios --fail-severity warning && postman environment lint postman/environments --fail-severity warning",
    "api:sandbox": "node --import tsx scripts/postman.mjs sandbox",
    "api:mock": "postman mock run postman/mocks/bobina --port 4010 --no-history",
    "test:api": "node --import tsx scripts/postman.mjs real",
    "test:api:regressions": "node --import tsx scripts/postman.mjs real --regressions",
    "test:api:mock": "node --import tsx scripts/postman.mjs mock",
    "test:api:mock:regressions": "node --import tsx scripts/postman.mjs mock --regressions",
    "test:api:export": "node --import tsx scripts/postman.mjs mock --export",
    "test:web": "node --import tsx --test web/tests/*.test.ts",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run build && npm test && npm run test:web && npm run postman:lint",
    "check:api": "npm run test:api && npm run test:api:regressions && npm run test:api:mock && npm run test:api:mock:regressions"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.6",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "fastify": "^5.12.7",
    "lucide-react": "^1.59.0",
    "motion": "^12.43.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postman-cli": "^1.75.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.4"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  }
}
